/**
 * Lead & Customer Manager
 * Central configuration and entry points (menu, web app).
 */

var SHEET_NAMES = {
  LEADS: 'Leads',
  CUSTOMERS: 'Customers',
  TODOS: 'ToDos'
};

var LEAD_HEADERS = ['ID', 'Name', 'Company', 'Email', 'Phone', 'Source', 'Stage',
  'Value', 'Owner', 'CreatedDate', 'LastContactDate', 'NextFollowUpDate', 'Notes', 'LastUpdated'];

var CUSTOMER_HEADERS = ['ID', 'Name', 'Company', 'Email', 'Phone', 'LeadID', 'Stage',
  'LifetimeValue', 'Owner', 'CreatedDate', 'LastContactDate', 'Notes', 'LastUpdated'];

var TODO_HEADERS = ['ID', 'RelatedType', 'RelatedID', 'RelatedName', 'Task', 'DueDate',
  'Priority', 'Status', 'Reason', 'AutoGenerated', 'CreatedDate', 'CompletedDate'];

var LEAD_STAGES = ['New', 'Contacted', 'Qualified', 'Proposal Sent', 'Negotiation', 'Won', 'Lost'];
var CUSTOMER_STAGES = ['New', 'Active', 'VIP', 'At Risk', 'Churned'];
var TODO_PRIORITIES = ['High', 'Medium', 'Low'];
var TODO_STATUSES = ['Open', 'Done'];

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('Lead & Customer Manager')
    .addItem('Open Dashboard', 'showDashboardDialog')
    .addSeparator()
    .addItem('Set Up / Repair Sheets', 'setupSpreadsheet')
    .addSeparator()
    .addItem('Add Lead...', 'showAddLeadSidebar')
    .addItem('Add Customer...', 'showAddCustomerSidebar')
    .addSeparator()
    .addItem('Recommend Task for Selected Row', 'recommendTaskForSelection')
    .addToUi();
}

function doGet(e) {
  return HtmlService.createTemplateFromFile('Index')
    .evaluate()
    .setTitle('Lead & Customer Manager')
    .addMetaTag('viewport', 'width=device-width, initial-scale=1')
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

function showDashboardDialog() {
  var url = ScriptApp.getService().getUrl();
  var html;
  if (url) {
    html = HtmlService.createHtmlOutput(
      '<p style="font-family:Roboto,Arial,sans-serif">Your dashboard is deployed. Open it here:</p>' +
      '<p><a href="' + url + '" target="_blank" style="font-family:Roboto,Arial,sans-serif">' + url + '</a></p>'
    ).setWidth(420).setHeight(140);
  } else {
    html = HtmlService.createHtmlOutput(
      '<p style="font-family:Roboto,Arial,sans-serif">No web app deployment found yet.<br>' +
      'Use <b>Deploy &gt; New deployment &gt; Web app</b> in the Apps Script editor, then reopen this menu.</p>'
    ).setWidth(420).setHeight(140);
  }
  SpreadsheetApp.getUi().showModalDialog(html, 'Lead & Customer Manager');
}

function showAddLeadSidebar() {
  var html = HtmlService.createHtmlOutputFromFile('Sidebar_AddLead')
    .setTitle('Add New Lead');
  SpreadsheetApp.getUi().showSidebar(html);
}

function showAddCustomerSidebar() {
  var html = HtmlService.createHtmlOutputFromFile('Sidebar_AddCustomer')
    .setTitle('Add New Customer');
  SpreadsheetApp.getUi().showSidebar(html);
}

function getConfig() {
  return {
    leadStages: LEAD_STAGES,
    customerStages: CUSTOMER_STAGES,
    priorities: TODO_PRIORITIES
  };
}

/** Single call the web app uses on load / refresh to fetch everything at once. */
function getDashboardData() {
  return {
    config: getConfig(),
    leads: getLeads(),
    customers: getCustomers(),
    todos: getTodos()
  };
}
