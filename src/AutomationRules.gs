/**
 * Status-based next-step automation.
 *
 * Every rule below carries a human-readable "reason" — the chain of thought
 * behind the recommendation — which is stored on the ToDo row itself so
 * anyone looking at the task list can see *why* it was suggested, not just
 * what to do.
 */

var LEAD_STAGE_RULES = {
  'New': {
    task: 'Make first contact with {name}',
    daysOffset: 1,
    priority: 'High',
    reason: 'Lead just entered the pipeline. Fast first contact (ideally within 24-48h) has the biggest impact on conversion.'
  },
  'Contacted': {
    task: 'Send discovery questions / schedule a call with {name}',
    daysOffset: 2,
    priority: 'High',
    reason: 'Initial contact was made. Next step is to qualify the lead’s needs and budget before investing in a proposal.'
  },
  'Qualified': {
    task: 'Prepare and send a proposal to {name}',
    daysOffset: 3,
    priority: 'Medium',
    reason: 'Lead is qualified as a real opportunity, so the next logical step is putting a proposal in front of them.'
  },
  'Proposal Sent': {
    task: 'Follow up on the proposal with {name}',
    daysOffset: 5,
    priority: 'High',
    reason: 'Proposals go cold fast. A follow-up a few business days after sending keeps momentum and surfaces objections early.'
  },
  'Negotiation': {
    task: 'Finalize terms and close with {name}',
    daysOffset: 2,
    priority: 'High',
    reason: 'Deal is in active negotiation — interest is at its peak, so closing quickly reduces the risk of it stalling.'
  },
  'Won': {
    task: 'Kick off onboarding for {name}',
    daysOffset: 1,
    priority: 'High',
    reason: 'Deal is won. A fast, well-run onboarding sets the tone for the whole customer relationship.',
    autoConvertToCustomer: true
  },
  'Lost': {
    task: 'Log the loss reason and add {name} to the nurture list',
    daysOffset: 7,
    priority: 'Low',
    reason: 'Deal is lost, but capturing why (and a light-touch nurture cadence) keeps the door open for a future opportunity.'
  }
};

var CUSTOMER_STAGE_RULES = {
  'New': {
    task: 'Schedule an onboarding / kickoff call with {name}',
    daysOffset: 2,
    priority: 'High',
    reason: 'Customer just converted. An early kickoff call drives adoption and reduces early churn risk.'
  },
  'Active': null,
  'VIP': {
    task: 'Schedule an executive check-in with {name}',
    daysOffset: 7,
    priority: 'Medium',
    reason: 'Customer was marked VIP — proactive, high-touch attention protects a high-value relationship.'
  },
  'At Risk': {
    task: 'Urgent: reach out to at-risk customer {name}',
    daysOffset: 1,
    priority: 'High',
    reason: 'Customer was flagged at risk. Immediate outreach is the highest-leverage action to prevent churn.'
  },
  'Churned': {
    task: 'Send a win-back offer to {name}',
    daysOffset: 14,
    priority: 'Medium',
    reason: 'Customer churned. A win-back attempt after a short cooldown period can re-engage them without feeling pushy.'
  }
};

/**
 * Called whenever a Lead or Customer's Stage changes. Creates the
 * recommended follow-up ToDo (skipping duplicates) and, for a Lead moving
 * to "Won", auto-converts it into a Customer record.
 */
function applyStageAutomation(entityType, id, name, newStage) {
  var rules = entityType === SHEET_NAMES.LEADS ? LEAD_STAGE_RULES : CUSTOMER_STAGE_RULES;
  var rule = rules[newStage];
  if (!rule) return null;

  var created = createAutoTodoIfNotDuplicate_(entityType, id, name, rule);

  if (rule.autoConvertToCustomer && entityType === SHEET_NAMES.LEADS) {
    convertLeadToCustomer(id);
  }
  return created;
}

function createAutoTodoIfNotDuplicate_(entityType, id, name, rule) {
  var taskText = rule.task.replace('{name}', name);
  if (todoExists_(id, taskText)) return null;

  var dueDate = addDays(new Date(), rule.daysOffset);
  return addTodo({
    RelatedType: entityType === SHEET_NAMES.LEADS ? 'Lead' : 'Customer',
    RelatedID: id,
    RelatedName: name,
    Task: taskText,
    DueDate: dueDate,
    Priority: rule.priority,
    Reason: rule.reason,
    AutoGenerated: 'Y'
  });
}

function todoExists_(relatedId, taskText) {
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  var rows = sheetToObjects(sheet);
  return rows.some(function (row) {
    return row.RelatedID === relatedId && row.Task === taskText && row.Status === 'Open';
  });
}
