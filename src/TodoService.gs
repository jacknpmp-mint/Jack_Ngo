/**
 * CRUD for the ToDos sheet, plus the manual "recommend a task for the
 * currently selected row" menu action.
 */

function getTodos() {
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  return sheetToObjects(sheet).map(function (t) {
    t.DueDate = formatDateForUi(t.DueDate);
    t.CreatedDate = formatDateForUi(t.CreatedDate);
    t.CompletedDate = formatDateForUi(t.CompletedDate);
    return t;
  }).sort(function (a, b) {
    if (a.Status !== b.Status) return a.Status === 'Open' ? -1 : 1;
    return (a.DueDate || '').localeCompare(b.DueDate || '');
  });
}

function addTodo(form) {
  if (!form.Task) throw new Error('Task text is required.');
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  var now = new Date();
  var record = {
    ID: generateId('T'),
    RelatedType: form.RelatedType || 'General',
    RelatedID: form.RelatedID || '',
    RelatedName: form.RelatedName || '',
    Task: form.Task,
    DueDate: parseDueDate_(form.DueDate) || addDays(now, 3),
    Priority: form.Priority || 'Medium',
    Status: 'Open',
    Reason: form.Reason || 'Manually added.',
    AutoGenerated: form.AutoGenerated || 'N',
    CreatedDate: now,
    CompletedDate: ''
  };
  appendObjectRow(sheet, record, TODO_HEADERS);
  return record;
}

function parseDueDate_(value) {
  if (!value) return null;
  if (value instanceof Date) return value;
  var d = new Date(value);
  return isNaN(d.getTime()) ? null : d;
}

function completeTodo(id) {
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  var row = findRowById(sheet, id);
  if (row === -1) throw new Error('Task not found: ' + id);
  setCellByHeader(sheet, row, 'Status', 'Done');
  setCellByHeader(sheet, row, 'CompletedDate', new Date());
  return true;
}

function reopenTodo(id) {
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  var row = findRowById(sheet, id);
  if (row === -1) throw new Error('Task not found: ' + id);
  setCellByHeader(sheet, row, 'Status', 'Open');
  setCellByHeader(sheet, row, 'CompletedDate', '');
  return true;
}

function deleteTodo(id) {
  var sheet = getSheetOrThrow(SHEET_NAMES.TODOS);
  var row = findRowById(sheet, id);
  if (row === -1) throw new Error('Task not found: ' + id);
  sheet.deleteRow(row);
  return true;
}

/** Menu action: reads the Stage of the currently selected Lead/Customer row and creates its recommended task on demand. */
function recommendTaskForSelection() {
  var ui = SpreadsheetApp.getUi();
  var sheet = SpreadsheetApp.getActiveSheet();
  var name = sheet.getName();
  if (name !== SHEET_NAMES.LEADS && name !== SHEET_NAMES.CUSTOMERS) {
    ui.alert('Select a row in the Leads or Customers sheet first.');
    return;
  }
  var row = sheet.getActiveRange().getRow();
  if (row < 2) {
    ui.alert('Select a data row (not the header) first.');
    return;
  }
  var id = getCellByHeader(sheet, row, 'ID');
  var rowName = getCellByHeader(sheet, row, 'Name');
  var stage = getCellByHeader(sheet, row, 'Stage');
  var result = applyStageAutomation(name, id, rowName, stage);
  if (result) {
    ui.alert('Task recommended', result.Task + '\n\nWhy: ' + result.Reason, ui.ButtonSet.OK);
  } else {
    ui.alert('No new recommendation (either no rule for this stage, or an open task already exists).');
  }
}
